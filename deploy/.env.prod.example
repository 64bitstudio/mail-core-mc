# Ticket 011 — plantilla de deploy/.env.prod (real, con valores reales,
# vive SOLO en la VM en /home/ubuntu/secrets/mail-core-mc/.env.prod,
# gitignored). Mismo patrón que auth-core-mc/deploy/.env.prod.example
# (ticket 049).
#
# DB_PASSWORD es el único valor estrictamente obligatorio para que el
# stack arranque (ver docker-compose.dev.yml: sin él, Compose se niega a
# levantar el servicio con un mensaje explícito) — lo obtiene
# corePipeline.groovy de Vault (secret/mail-core-mc/prod) en cada deploy,
# igual que ya hace para auth-core-mc; nunca a mano.
#
# SMTP_*/BOUNCES_MAILDIR_PATH: dependen del ticket 009 (migración del
# MTA a esta VM), todavía en curso — vacíos por defecto a propósito (ver
# docs/ARQUITECTURA.md, ticket 011, "Dependencia real con el ticket
# 009"). El stack arranca igual sin ellos: el healthcheck de este
# servicio (GET /health) solo valida Postgres/Redis.

# Imagen a desplegar — la asigna corePipeline (SHA del commit), no a mano.
IMAGE_TAG=

DB_PASSWORD=cambiar-por-una-contrasena-real-de-prod

AUTH_CORE_MC_ISSUER_URI=https://auth.64bitstudio.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mail.64bitstudio.com
SMTP_IGNORE_TLS=true

VERP_DOMAIN=mail.64bitstudio.com
BOUNCES_MAILDIR_PATH=

TRANSACTIONAL_MAX_ATTEMPTS=5
TRANSACTIONAL_BACKOFF_DELAY_MS=2000
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BACKOFF_DELAY_MS=2000
