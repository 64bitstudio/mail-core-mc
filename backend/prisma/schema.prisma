// Esquema base de mail-core-mc (ticket 002, Fase 1).
//
// Solo los 4 modelos que HU-1 a HU-6 necesitan (envío transaccional,
// plantillas, auth, supresión). Contact/List/Segment/Campaign llegan en la
// Fase 3 (CRM de marketing) — ver docs/definiciones/mail-core-mc-v1.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Identidad de remitente por tenant (Fase 2, HU-8). Ya se modela desde
// ahora porque Message.tenantId la referencia, pero from_display_name /
// reply_to / branding se usan hasta que HU-8 se implemente — hasta
// entonces todo tenant usa el remitente por defecto del ecosistema.
model Tenant {
  id               String   @id @default(uuid())
  name             String
  // Ticket 005: el tenant de negocio del llamante (ej. el tenant "Acme"
  // dentro de auth-core-mc), string libre — no se valida contra
  // auth-core-mc todavía (eso sería Fase 2). "__default__" es el tenant
  // compartido cuando el llamante no manda tenantId. find-or-create por
  // este campo en vez de por `id` porque `id` es nuestro UUID interno,
  // no algo que el llamante conozca.
  externalId       String?  @unique @map("external_id")
  fromDisplayName  String?  @map("from_display_name")
  replyTo          String?  @map("reply_to")
  brandColor       String?  @map("brand_color")
  createdAt        DateTime @default(now()) @map("created_at")

  templates Template[]
  messages  Message[]
  webhookSubscription WebhookSubscription?

  @@map("tenants")
}

model Template {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id") // null = plantilla compartida/del sistema
  name      String
  subject   String
  htmlBody  String   @map("html_body")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant?   @relation(fields: [tenantId], references: [id])
  messages Message[]

  @@map("templates")
}

enum MessageType {
  transactional
  marketing
}

// Sin enum de status: HU-3/HU-4 van agregando estados sobre la marcha
// (queued, sent, delivered, bounced, failed, suppressed) y un enum en el
// esquema obligaría a una migración por cada estado nuevo. String simple
// + validación en la capa de aplicación (ticket 005).
model Message {
  id                String      @id @default(uuid())
  tenantId          String      @map("tenant_id")
  templateId        String?     @map("template_id")
  type              MessageType @default(transactional)
  status            String      @default("queued")
  recipientEmail    String      @map("recipient_email")
  renderedSubject   String?     @map("rendered_subject")
  // El worker (ticket 004) solo envía correo ya renderizado — nunca
  // vuelve a llamar a TemplatesService.render() ni a Handlebars, así que
  // necesita el HTML final guardado, no solo el subject.
  renderedHtml      String?     @map("rendered_html")
  providerMessageId String?     @map("provider_message_id")
  attemptsMade      Int         @default(0) @map("attempts_made")
  lastError         String?     @map("last_error")
  createdAt         DateTime    @default(now()) @map("created_at")
  sentAt            DateTime?   @map("sent_at")
  lastStatusAt      DateTime?   @map("last_status_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  template Template? @relation(fields: [templateId], references: [id])

  @@index([recipientEmail])
  @@index([status])
  @@map("messages")
}

// Lista de supresión — HU-4. tenantId nulo = supresión global (bounce
// duro o complaint aplica a cualquier tenant, no solo al que lo originó).
model SuppressionEntry {
  id        String   @id @default(uuid())
  email     String
  reason    String // bounce | complaint | unsubscribe
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email, tenantId])
  @@index([email])
  @@map("suppression_entries")
}

// Webhook de estado de entrega — HU-5, ticket 007. Un webhook por
// tenant por ahora (v1, simplicidad — múltiples webhooks/tenant es
// extensión futura si hace falta). El secret se guarda en texto plano
// a propósito: es una llave simétrica de firma (HMAC), no una
// contraseña — hay que poder recuperarla para firmar cada request, no
// solo compararla (distinto de client_secret_hash en auth-core-mc).
model WebhookSubscription {
  id        String   @id @default(uuid())
  tenantId  String   @unique @map("tenant_id")
  url       String
  secret    String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("webhook_subscriptions")
}
