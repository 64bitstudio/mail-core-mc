# Copia este archivo a .env y ajusta los valores. .env nunca se versiona.

# Ver compose.yaml — el puerto real es efímero (Docker lo asigna al azar
# para no chocar con otro Postgres que ya corra en :5432 en esta máquina).
# Después de `docker compose up -d`, obtén el puerto real con:
#   docker compose port postgres 5432
#   docker compose port redis 6379
DATABASE_URL="postgresql://mail_core_mc:mail_core_mc_dev@localhost:5432/mail_core_mc?schema=public"
REDIS_URL="redis://localhost:6379"

# Instancia transaccional de Postfix (ticket 001, infra/mta/). Credenciales
# de la cuenta noreply@mail.64bitstudio.com — pídelas o revisa
# infra/mta/docker-data/dms/config/postfix-accounts.cf en tu máquina.
SMTP_HOST="localhost"
SMTP_PORT="587"
SMTP_USER="noreply@mail.64bitstudio.com"
SMTP_PASSWORD=""
SMTP_FROM="noreply@mail.64bitstudio.com"
# La instancia de dev no anuncia STARTTLS a propósito (ver docs/ARQUITECTURA.md) —
# poner "false" solo cuando el servidor SMTP destino sí lo soporte (VM/producción, ticket 009).
SMTP_IGNORE_TLS="true"

# Cola transaccional (ticket 004) — reintentos con backoff exponencial.
TRANSACTIONAL_MAX_ATTEMPTS="5"
TRANSACTIONAL_BACKOFF_DELAY_MS="2000"

# Resource server OAuth2 (ticket 005) — mail-core-mc valida JWTs de
# auth-core-mc contra su JWK Set. AUTH_CORE_MC_CLIENT_ID/SECRET son las
# credenciales que mail-core-mc usaría si necesitara pedir SU PROPIO
# token (ej. para pruebas manuales) — el resource server en sí solo
# necesita ISSUER_URI, las otras dos no son requeridas para validar
# tokens ajenos, solo para obtener uno propio de prueba.
AUTH_CORE_MC_ISSUER_URI="http://localhost:8080"
AUTH_CORE_MC_CLIENT_ID="mail-core-mc"
AUTH_CORE_MC_CLIENT_SECRET=""

# Bounces/complaints (ticket 006) — VERP + buzón dedicado bounces@ (ver
# infra/mta/). BOUNCES_MAILDIR_PATH apunta a la carpeta new/ de ese
# Maildir en tu máquina — ajusta si tu ruta de infra/mta/ difiere.
VERP_DOMAIN="mail.64bitstudio.com"
BOUNCES_MAILDIR_PATH="../infra/mta/docker-data/dms/mail-data/mail.64bitstudio.com/bounces/new"

# Webhooks de estado de entrega (ticket 007) — reintentos con backoff
# exponencial, mismo patrón que la cola transaccional.
WEBHOOK_MAX_ATTEMPTS="5"
WEBHOOK_BACKOFF_DELAY_MS="2000"
