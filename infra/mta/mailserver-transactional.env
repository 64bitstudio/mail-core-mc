# Config no-secreta de docker-mailserver para la instancia transaccional.
# Las contraseñas de cuentas SMTP viven hasheadas en
# docker-data/dms/config/postfix-accounts.cf (generado por setup.sh, dentro
# de docker-data/ que está en .gitignore) — nunca en este archivo.

OVERRIDE_HOSTNAME=mail.64bitstudio.com
POSTMASTER_ADDRESS=postmaster@mail.64bitstudio.com

# Firma DKIM saliente — el propósito de este ticket.
ENABLE_OPENDKIM=1

# Nada de esto aplica a un relay puramente saliente en fase dev:
# ENABLE_OPENDMARC / ENABLE_POLICYD_SPF validan correo ENTRANTE (no lo
# necesitamos hasta el ticket 006 de bounces); antivirus/antispam/fail2ban
# son para un servidor que también recibe tráfico público, no para esta
# instancia de dev.
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_CLAMAV=0
ENABLE_RSPAMD=0
ENABLE_FAIL2BAN=0
ENABLE_SPAMASSASSIN=0

# TLS real (SSL_TYPE) queda pendiente para la VM (necesita el certificado
# del dominio final) — en dev el submission port solo se expone en
# 127.0.0.1, nunca a la red pública.
SSL_TYPE=

# Permite que mail-core-mc (fuera de este compose, en la misma máquina de
# dev) se autentique en el puerto 587 sin más restricciones de red.
PERMIT_DOCKER=host
