# Node / TypeScript
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
npm-debug.log*

# Env / secrets
.env
.env.*
!.env.example
# Ticket 011: los .env reales de DEV/QA/PROD viven SOLO en la VM (nunca en
# el checkout de git — ver docs/ARQUITECTURA.md, ticket 011), mismo patrón
# que auth-core-mc/.gitignore (ticket 049). Sin estas excepciones, el
# patrón ".env.*" de arriba también ignora las plantillas committeadas.
!deploy/.env.dev.example
!deploy/.env.qa.example
!deploy/.env.prod.example

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# MTA (ticket 001): claves DKIM privadas, hashes de contraseñas de cuentas
# SMTP y estado del contenedor — nunca al repo.
infra/mta/docker-data/

# Estado local de la sesión de Claude Code (locks de tareas programadas),
# no es parte del proyecto.
.claude/scheduled_tasks.lock
